flowchart TD
  A["Tenant registered"] --> B["OAuth authenticate"]
  B --> C["Create subscription,
up to 250 users each"]
  C --> D["Receive events over PubNub"]
  D --> E{"15-minute expiry
coming?"}
  E -- "renew 1 minute before" --> D
  B --> F["Refresh token every hour"]
  G["Rule assigned or removed"] --> H["Update the subscription's user list"]
  I["More than 250 users"] --> C
  J["No mapped users,
or BU deactivated"] --> K["Cancel subscription"]
  class A,B,C,D,F,H psa
  class E decide
  class G,I,J partner
  class K stop
