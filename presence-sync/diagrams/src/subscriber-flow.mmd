---
config:
  flowchart:
    htmlLabels: false
    curve: basis
---
flowchart TD
  A["Partner event: call connected, call ended,
DND or presence change"] --> B["Partner adapter: PubNub,
WebSocket, webhook or polling"]
  B --> C["Normalize to one generic internal event"]
  C --> T{"Agent leg tag
set in Redis?"}
  T -- "Yes" --> X0["Ignore: the contact center's own call"]
  T -- "No" --> T2{"Number on the call is a
customer-line number?
tenant configuration"}
  T2 -- "Yes" --> X0
  T2 -- "No" --> E{"Agent mapped, rule type
Subscriber or Bidirectional?"}
  E -- "No" --> X["Ignore"]
  E -- "Yes" --> F{"Agent's current
ACD state?"}
  F -- "Available" --> G["Set state: Unavailable-UC
no customer voice calls"]
  F -- "Working or ACW" --> H["Set NEXT state: Unavailable-UC
current contact not interrupted"]
  F -- "Unavailable, set by the agent" --> I["No change: the agent's choice wins"]
  G --> J["gRPC set state on the ACD,
cache previous state in Redis"]
  H --> J
  G -.- CH["Omnichannel agents: applies to voice;
chat, email and social keep flowing"]
  J --> K["Partner call ends"]
  K --> L{"Did PSA make
the last change?"}
  L -- "Yes" --> M["Restore last permanent state,
e.g. back to Lunch"]
  L -- "No" --> N["Leave it: the agent changed it"]
  class A,B partner
  class C,G,H,J,K,M psa
  class T,T2,E,F,L decide
  class X0,X,I,N stop
  class CH ok
  classDef psa fill:#e6eefc,stroke:#2f5fd0,stroke-width:2px,color:#1f2a37
  classDef cc fill:#f1f3f6,stroke:#7a8797,stroke-width:2px,color:#1f2a37
  classDef partner fill:#f3ecff,stroke:#7b4fd6,stroke-width:2px,color:#1f2a37
  classDef decide fill:#fff8e1,stroke:#b8941a,stroke-width:2px,color:#1f2a37
  classDef stop fill:#fde8e8,stroke:#d64545,stroke-width:2px,color:#1f2a37
  classDef ok fill:#eaf7ef,stroke:#2f9e5b,stroke-width:2px,color:#1f2a37
