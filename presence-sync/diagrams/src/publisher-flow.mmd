---
config:
  flowchart:
    htmlLabels: false
    curve: basis
---
flowchart TD
  A["Agent's state changes in MAX
e.g. a customer call arrives: Working"] --> B[("Agent event stream
Kafka to Kinesis")]
  B --> C["Kinesis consumer"]
  C --> D["Transformer: normalize the event"]
  D --> E{"Agent mapped and
rule assigned?"}
  E -- "No" --> X["Ignore"]
  E -- "Yes" --> F{"Rule type?"}
  F -- "Subscriber only" --> X2["No outbound update"]
  F -- "Publisher or Bidirectional" --> G{"Rule sets Busy or DND?"}
  G -- "DND" --> H["Partner presence: Do Not Disturb
internal calls don't ring"]
  G -- "Busy" --> I["Partner presence: Busy
calls still ring; agent can decline or hold"]
  H --> J["Partner actor, BU actor, State Updating actor
call the partner's set-presence API"]
  I --> J
  J --> K[("Redis: previous and current state
consistent hashing keeps each agent in order")]
  J --> L["Contact ends: restore the previous
partner presence, if PSA set it"]
  class A,B cc
  class C,D,J,L psa
  class E,F,G decide
  class X,X2 stop
  class H,I partner
  class K ok
  classDef psa fill:#e6eefc,stroke:#2f5fd0,stroke-width:2px,color:#1f2a37
  classDef cc fill:#f1f3f6,stroke:#7a8797,stroke-width:2px,color:#1f2a37
  classDef partner fill:#f3ecff,stroke:#7b4fd6,stroke-width:2px,color:#1f2a37
  classDef decide fill:#fff8e1,stroke:#b8941a,stroke-width:2px,color:#1f2a37
  classDef stop fill:#fde8e8,stroke:#d64545,stroke-width:2px,color:#1f2a37
  classDef ok fill:#eaf7ef,stroke:#2f9e5b,stroke-width:2px,color:#1f2a37
